# Copy to .env.local and fill in. Variable names only: never commit real values.

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Stripe, test mode until launch review is complete)
NEXT_PUBLIC_PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Marketplace commission in basis points (1000 = 10%). Checkout stays disabled until set.
MARKETPLACE_COMMISSION_BPS=

# --- AI Jeweler (server only)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# --- Report verification (optional; manual review is used when unset)
GIA_REPORT_RESULTS_API_KEY=
GIA_REPORT_RESULTS_API_ENDPOINT=
